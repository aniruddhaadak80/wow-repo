# Copy to .env.local and fill in. Nothing here is required for a local build.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Repository URL used for issue links and the GitHub CTA. A fork sets this to
# its own clone URL so the Contribute section points at the right issues.
NEXT_PUBLIC_REPO_URL=https://github.com/aniruddhaadak/wow-repo
